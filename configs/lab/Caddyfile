# Local, authorized lab target (compose.dev.yaml). Serves a tiny static site over HTTP and
# HTTPS (Caddy internal CA) so httpx, tlsx and katana can be exercised safely.
{
	local_certs
	skip_install_trust
	auto_https disable_redirects
	admin off
}

(site) {
	log {
		output stdout
		format json
	}
	# To exercise the technology -> CPE -> NVD CVE correlation locally, temporarily replace this with
	# a SIMULATED versioned banner, e.g. header Server "nginx/1.24.0" (docs/vulnerability-intel.md).
	header Server "bb-lab"
	# DELIBERATE bait (fake, no credentials): the nuclei baseline policy reports it via the git-config
	# exposure template, so the finding/change pipeline can be verified end to end. (Served from here
	# because git refuses to track a path containing a ".git" directory.)
	respond /.git/config `[core]
	repositoryformatversion = 0
	bare = false
[remote "origin"]
	url = https://example.invalid/bb-lab/site.git
` 200
	root * /srv
	try_files {path} {path}/index.html
	file_server
}

:80 {
	import site
}

https://10.89.250.10, https://lab-target.bb.test {
	tls internal
	import site
}
