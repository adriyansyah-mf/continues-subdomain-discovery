# ---------------------------------------------------------------------------
# Bug bounty platform configuration. Copy to .env and replace every CHANGE_ME
# (`make env` generates random secrets). Never commit .env.
# In production prefer Docker secrets: every *_PASSWORD / *_KEY can also be read
# from /run/secrets/<NAME> or <NAME>_FILE (see docs/deployment.md).
# ---------------------------------------------------------------------------
PLATFORM_VERSION=0.1.0
BB_ENVIRONMENT=development
LOG_LEVEL=INFO

# --- pinned image versions (never "latest") ---------------------------------
ELASTIC_VERSION=8.19.22
KIBANA_VERSION=8.19.22
LOGSTASH_VERSION=8.19.22
POSTGRES_VERSION=17.11-alpine
REDIS_VERSION=8.2.10-alpine
CADDY_VERSION=2.11.4-alpine

# --- pinned scanner versions (ProjectDiscovery release tags) ------------------
HTTPX_VERSION=1.12.0
TLSX_VERSION=1.4.0
MAPCIDR_VERSION=1.1.97
UNCOVER_VERSION=1.2.1
KATANA_VERSION=1.7.0
NUCLEI_VERSION=3.11.1
# nuclei templates are cloned at build time and verified against this commit SHA
# (tag -> commit from https://api.github.com/repos/projectdiscovery/nuclei-templates/git/ref/tags/<tag>)
NUCLEI_TEMPLATES_VERSION=10.4.9
NUCLEI_TEMPLATES_COMMIT=893122ffce8ebf8e264f15d2cd3960cb1dd36d6c
BBOT_VERSION=3.0.2

# --- Elasticsearch / Kibana / Logstash ---------------------------------------
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_SYSTEM_PASSWORD=CHANGE_ME
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING
LOGSTASH_WRITER_PASSWORD=CHANGE_ME
ES_MONITOR_PASSWORD=CHANGE_ME
ES_HEAP=1g
LOGSTASH_HEAP=768m
KIBANA_NODE_MEMORY_MB=1024
# Disk watermarks accept % or absolute free space (e.g. 5gb) - absolute values help on large, full disks.
ES_DISK_WATERMARK_LOW=85%
ES_DISK_WATERMARK_HIGH=90%
ES_DISK_WATERMARK_FLOOD=95%

# --- PostgreSQL / Redis ----------------------------------------------------------
POSTGRES_DB=bugbounty
POSTGRES_USER=bugbounty
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0

# --- API --------------------------------------------------------------------------
# Admin API key registered on first start (>= 24 chars). bbctl reads BB_API_KEY or this.
BB_BOOTSTRAP_ADMIN_KEY=CHANGE_ME_AT_LEAST_24_CHARACTERS
BB_API_URL=http://127.0.0.1:18000

# --- host ports (127.0.0.1 only) ----------------------------------------------------
API_PORT=18000
ES_PORT=19200
KIBANA_PORT=15601
POSTGRES_DEV_PORT=15432
REDIS_DEV_PORT=16379

# --- data sources -----------------------------------------------------------------
# Public endpoint (may be silent). For a self-hosted stream set COMPOSE_PROFILES=ct-server and
# CERTSTREAM_URL=ws://certstream-server:8080/
CERTSTREAM_URL=wss://certstream.calidog.io
CERTSTREAM_SERVER_VERSION=v1.10.1
# Reconnect when the stream sends nothing (not even heartbeats) for this many seconds.
CERTSTREAM_IDLE_TIMEOUT=300
# Keep certificates matching no program (passive only; high volume). Default: drop them.
CERTSTREAM_STORE_OUT_OF_SCOPE=false
# Follow-up scanners queued for NEW in-scope assets of ACTIVE programs (comma-separated, empty = none)
CERTSTREAM_FOLLOWUP_SCANNERS=dns
BOUNTY_TARGETS_URL=https://raw.githubusercontent.com/arkadiyt/bounty-targets-data/main/data/domains.txt
IPRANGES_REPO=https://github.com/lord-alfred/ipranges
# Automatic provider-range refresh interval in seconds (0 = only via `bbctl sync ipranges`)
IPRANGES_SYNC_INTERVAL=86400
# IP -> ASN enrichment (iptoasn.com, public). Interval in seconds, 0 = only via `bbctl sync asn`.
ASN_FEED_URL=https://iptoasn.com/data/ip2asn-combined.tsv.gz
ASN_SYNC_INTERVAL=86400
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_FEED_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# Optional NVD API key: raises the NVD rate limit from 5 to 50 requests / 30 s.
NVD_API_KEY=
# Seconds between automatic runs (0 disables): KEV 6h, EPSS daily, CVE correlation daily.
KEV_SYNC_INTERVAL=21600
EPSS_SYNC_INTERVAL=86400
CVE_CORRELATION_INTERVAL=86400

# --- uncover search-engine API keys (empty = engine unavailable) -----------------------
SHODAN_API_KEY=
CENSYS_API_TOKEN=
CENSYS_ORGANIZATION_ID=
FOFA_KEY=
NETLAS_API_KEY=
ZOOMEYE_API_KEY=

# --- notifications -------------------------------------------------------------------
# Channels reference secrets by NAME (secret_ref); set the values here or as Docker secrets.
NOTIFY_SLACK_WEBHOOK=
NOTIFY_DISCORD_WEBHOOK=
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_SMTP_PASSWORD=
NOTIFY_RATE_PER_MINUTE=20
# Only for lab testing: allow http:// and private-address destinations.
NOTIFY_ALLOW_PRIVATE_DESTINATIONS=false

# --- container limits ---------------------------------------------------------------
WORKER_MEM_LIMIT=768m
BBOT_MEM_LIMIT=2g
# Time a stopping worker gets to finish its current job before it is killed
WORKER_STOP_GRACE=180s
BBOT_STOP_GRACE=600s

# --- scanner rate limits: global caps, policies may only go lower (req/s) ------------
HTTPX_RATE_LIMIT=20
TLSX_RATE_LIMIT=20
NUCLEI_RATE_LIMIT=10
KATANA_RATE_LIMIT=10
BBOT_RATE_LIMIT=10

# --- resource limits ---------------------------------------------------------------
MAX_CONCURRENCY=4
MAX_CONCURRENT_SCANS=4
# Cluster-wide concurrent active jobs per program and per target host (0 = unlimited)
PROGRAM_MAX_CONCURRENT=8
PER_HOST_MAX_CONCURRENT=1
# Fair share: max jobs per (program, scanner) waiting in the queue at once (0 = unlimited)
DISPATCH_MAX_QUEUED_PER_PROGRAM=25
MAX_CIDR_SIZE=256
MAX_IPS_PER_JOB=256
MAX_URLS_PER_CRAWL=1000
MAX_CRAWL_DEPTH=3
MAX_SCAN_DURATION=900
# Refuse targets resolving to private/loopback/link-local space unless that IP is explicitly in scope.
ALLOW_PRIVATE_TARGETS=false
# Identification header sent by httpx and katana on every request (many programs require one).
# Example (quote it - the value contains a space): BB_REQUEST_HEADER="X-Bug-Bounty: yourhandle"
BB_REQUEST_HEADER=
